{
 "block_card": {
  "description": "Block a card.",
  "name": "block_card",
  "parameters": {
   "properties": {
    "card_id": {
     "description": "Card identifier.",
     "type": "string"
    },
    "notify_customer": {
     "description": "Send a notification to the customer.",
     "type": "boolean"
    },
    "reason": {
     "description": "Why the card is blocked.",
     "enum": [
      "lost",
      "stolen",
      "fraud_suspected",
      "customer_request"
     ],
     "type": "string"
    }
   },
   "required": [
    "card_id",
    "reason"
   ],
   "type": "object"
  },
  "version": "1.0.0"
 },
 "calculate_loan_payment": {
  "description": "Calculate the periodic payment on an amortizing loan.",
  "name": "calculate_loan_payment",
  "parameters": {
   "properties": {
    "annual_rate_pct": {
     "description": "Annual interest rate as a percent.",
     "maximum": 40,
     "minimum": 0,
     "type": "number"
    },
    "principal": {
     "description": "Loan amount, in dollars.",
     "maximum": 2000000,
     "minimum": 1000,
     "type": "number"
    },
    "term_months": {
     "description": "Loan term, in months.",
     "maximum": 360,
     "minimum": 6,
     "type": "integer"
    }
   },
   "required": [
    "principal",
    "annual_rate_pct",
    "term_months"
   ],
   "type": "object"
  },
  "version": "1.0.0"
 },
 "create_support_ticket": {
  "description": "Open a support ticket for a customer.",
  "name": "create_support_ticket",
  "parameters": {
   "properties": {
    "category": {
     "description": "Ticket category.",
     "enum": [
      "card",
      "payments",
      "online_banking",
      "other"
     ],
     "type": "string"
    },
    "customer_id": {
     "description": "Customer identifier.",
     "type": "string"
    },
    "description": {
     "description": "What the customer reports.",
     "maxLength": 500,
     "type": "string"
    },
    "priority": {
     "default": "normal",
     "description": "Ticket priority.",
     "enum": [
      "low",
      "normal",
      "high"
     ],
     "type": "string"
    }
   },
   "required": [
    "customer_id",
    "category"
   ],
   "type": "object"
  },
  "version": "1.1.0"
 },
 "get_account_balance": {
  "description": "Return the balance of one account.",
  "name": "get_account_balance",
  "parameters": {
   "properties": {
    "account_id": {
     "description": "Account identifier.",
     "type": "string"
    },
    "balance_type": {
     "default": "available",
     "description": "Which balance to return.",
     "enum": [
      "available",
      "pending",
      "ledger"
     ],
     "type": "string"
    },
    "include_holds": {
     "description": "Include funds on hold.",
     "type": "boolean"
    }
   },
   "required": [
    "account_id"
   ],
   "type": "object"
  },
  "version": "1.0.0"
 },
 "get_fx_rate": {
  "description": "Return an indicative exchange rate.",
  "name": "get_fx_rate",
  "parameters": {
   "properties": {
    "base_currency": {
     "description": "Three-letter base currency code.",
     "enum": [
      "USD",
      "EUR",
      "GBP",
      "CAD",
      "CHF"
     ],
     "type": "string"
    },
    "quote_currency": {
     "description": "Three-letter quote currency code.",
     "enum": [
      "USD",
      "EUR",
      "GBP",
      "CAD",
      "CHF"
     ],
     "type": "string"
    },
    "rate_type": {
     "default": "mid",
     "description": "Rate to return.",
     "enum": [
      "mid",
      "buy",
      "sell"
     ],
     "type": "string"
    }
   },
   "required": [
    "base_currency",
    "quote_currency"
   ],
   "type": "object"
  },
  "version": "1.0.0"
 },
 "get_transaction_history": {
  "description": "List recent transactions.",
  "name": "get_transaction_history",
  "parameters": {
   "properties": {
    "account_id": {
     "description": "Account identifier.",
     "type": "string"
    },
    "days_back": {
     "default": 30,
     "description": "How many days back to look, 1 to 90 days.",
     "maximum": 90,
     "minimum": 1,
     "type": "integer"
    },
    "limit": {
     "default": 50,
     "description": "Maximum rows returned.",
     "maximum": 200,
     "minimum": 1,
     "type": "integer"
    }
   },
   "required": [
    "account_id"
   ],
   "type": "object"
  },
  "version": "1.3.0"
 },
 "order_checks": {
  "description": "Order a box of checks.",
  "name": "order_checks",
  "parameters": {
   "properties": {
    "account_id": {
     "description": "Account identifier.",
     "type": "string"
    },
    "expedite": {
     "description": "Pay for faster delivery.",
     "type": "boolean"
    },
    "quantity": {
     "description": "Number of checks, 25 to 400.",
     "maximum": 400,
     "minimum": 25,
     "type": "integer"
    }
   },
   "required": [
    "account_id",
    "quantity"
   ],
   "type": "object"
  },
  "version": "1.0.0"
 },
 "schedule_payment": {
  "description": "Schedule a bill payment.",
  "name": "schedule_payment",
  "parameters": {
   "properties": {
    "account_id": {
     "description": "Paying account identifier.",
     "type": "string"
    },
    "amount": {
     "description": "Payment amount, in dollars.",
     "maximum": 25000,
     "minimum": 1,
     "type": "number"
    },
    "payee_id": {
     "description": "Payee identifier.",
     "type": "string"
    },
    "run_in_days": {
     "default": 0,
     "description": "Days until the payment runs, 0 to 60 days.",
     "maximum": 60,
     "minimum": 0,
     "type": "integer"
    }
   },
   "required": [
    "account_id",
    "payee_id",
    "amount"
   ],
   "type": "object"
  },
  "version": "2.0.0"
 },
 "transfer_funds": {
  "description": "Move money between two accounts of one customer.",
  "name": "transfer_funds",
  "parameters": {
   "properties": {
    "amount": {
     "description": "Amount to move, in dollars.",
     "maximum": 50000,
     "minimum": 0.01,
     "type": "number"
    },
    "from_account": {
     "description": "Source account identifier.",
     "type": "string"
    },
    "memo": {
     "description": "Free-text note.",
     "maxLength": 140,
     "type": "string"
    },
    "to_account": {
     "description": "Destination account identifier.",
     "type": "string"
    }
   },
   "required": [
    "from_account",
    "to_account",
    "amount"
   ],
   "type": "object"
  },
  "version": "1.2.0"
 },
 "update_contact_preferences": {
  "description": "Change how a customer is contacted.",
  "name": "update_contact_preferences",
  "parameters": {
   "properties": {
    "channel": {
     "description": "Contact channel.",
     "enum": [
      "email",
      "sms",
      "phone",
      "mail"
     ],
     "type": "string"
    },
    "customer_id": {
     "description": "Customer identifier.",
     "type": "string"
    },
    "opt_in": {
     "description": "Whether the customer agrees to be contacted on this channel.",
     "type": "boolean"
    }
   },
   "required": [
    "customer_id",
    "channel"
   ],
   "type": "object"
  },
  "version": "1.4.0"
 }
}
