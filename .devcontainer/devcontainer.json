{
  "name": "AI PM portfolio",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "customizations": {
    "codespaces": {
      "openFiles": [
        "README.md",
        "SURPRISES.md"
      ]
    },
    "vscode": {
      "settings": {},
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ]
    }
  },
  // The step scripts use only the standard library. These packages are for the Streamlit apps and for project 02.
  "updateContentCommand": "pip3 install --user streamlit pandas numpy plotly scipy",
  "postAttachCommand": {
    "server": "streamlit run 01-halluguard-bank-chatbot-safety/src/app.py --server.enableCORS false --server.enableXsrfProtection false"
  },
  "portsAttributes": {
    "8501": {
      "label": "HalluGuard app",
      "onAutoForward": "openPreview"
    }
  },
  "forwardPorts": [
    8501
  ]
}
