{
 "contract": "credit_triage_features",
 "version": "1.0.0",
 "unexpected_columns": "warn",
 "max_bad_rate": 0.02,
 "fields": [
  {
   "name": "application_id",
   "type": "string"
  },
  {
   "name": "dti_ratio",
   "type": "number",
   "min": 0,
   "max": 1.5,
   "unit": "ratio of monthly debt to monthly income"
  },
  {
   "name": "fico_score",
   "type": "integer",
   "min": 300,
   "max": 850,
   "unit": "score points"
  },
  {
   "name": "ltv_ratio",
   "type": "number",
   "min": 0,
   "max": 1.5,
   "unit": "ratio of loan to collateral value",
   "max_null_rate": 0.05
  },
  {
   "name": "annual_income_usd",
   "type": "number",
   "min": 0,
   "max": 5000000,
   "unit": "US dollars per year",
   "max_null_rate": 0.05
  },
  {
   "name": "employment_status",
   "type": "string",
   "allowed": [
    "employed",
    "self_employed",
    "retired",
    "student",
    "unemployed"
   ]
  },
  {
   "name": "months_on_book",
   "type": "integer",
   "min": 0,
   "max": 600,
   "unit": "months"
  }
 ]
}
